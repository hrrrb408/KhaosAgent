+def _json_nesting_within_limit(payload: bytes) -> bool:
+    depth = 0
+    in_string = False
+    escaped = False
+
+    for byte in payload:
+        if in_string:
+            if escaped:
+                escaped = False
+            elif byte == 0x5C:
+                escaped = True
+            elif byte == 0x22:
+                in_string = False
+            continue
+
+        if byte == 0x22:
+            in_string = True
+        elif byte in (0x7B, 0x5B):
+            depth += 1
+            if depth > MAX_JSON_NESTING:
+                return False
+        elif byte in (0x7D, 0x5D):
+            depth -= 1
+            if depth < 0:
+                return False
+
+    return depth == 0 and not in_string and not escaped
+
